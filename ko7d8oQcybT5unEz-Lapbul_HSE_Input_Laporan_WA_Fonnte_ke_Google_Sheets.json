    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const GRUB_MAP = {\n  '***@g.us': 'Grub 1 - Regional',\n  'GANTI_ID_GRUB_AREA_LAIN@g.us': 'Grub 2 - Area Lain'\n};\n\nconst j = $input.item.json;\nconst pesan = (j.pesan || '').toString();\nconst t = pesan.toLowerCase();\nconst grub = GRUB_MAP[j.grubId] || '';\n\n// === AREA DETECTION ===\nlet area = '';\nif (t.includes('bukit siguntang') || t.includes('msc')) area = 'MSC Bukit Siguntang';\nelse if (t.includes('palembang')) area = 'Palembang';\nelse if (t.includes('lampung')) area = 'Lampung';\nelse if (t.includes('jambi')) area = 'Jambi';\nelse if (t.includes('bengkulu')) area = 'Bengkulu';\n\n// === KATEGORI DETECTION ===\nlet kategori = 'Lainnya';\nif (t.includes('safety talk') || t.includes('briefing')) kategori = 'Safety Talk/Briefing Pagi';\nelse if (t.includes('toolbox')) kategori = 'Safety Toolbox Meeting';\nelse if (t.includes('induction') || t.includes('induksi')) kategori = 'Safety Induction';\nelse if (t.includes('jsa') || t.includes('job safety')) kategori = 'JSA (Job Safety Analysis)';\nelse if (t.includes('hse message') || t.includes('pekerjaan hse')) kategori = 'Pekerjaan HSE/HSE Message';\nelse if (t.includes('sosialisasi') || t.includes('pelatihan')) kategori = 'Pelatihan & Sosialisasi';\nelse if (t.includes('patrol') || t.includes('patroli') || t.includes('inspeksi')) kategori = 'Inspeksi/Patrol K3';\nelse if (t.includes('kecelakaan') || t.includes('incident')) kategori = 'Incident Report';\n\n// === TANGGAL PARSING ===\nconst bulan = { januari: '01', februari: '02', maret: '03', april: '04', mei: '05', juni: '06', juli: '07', agustus: '08', september: '09', oktober: '10', november: '11', desember: '12' };\nlet tanggal = $now.toFormat('yyyy-MM-dd');\nconst m = pesan.match(/(\\d{1,2})[\\s\\/]+(Januari|Februari|Maret|April|Mei|Juni|Juli|Agustus|September|Oktober|November|Desember)[\\s\\/]+(\\d{4})/i);\nif (m) tanggal = m[3] + '-' + bulan[m[2].toLowerCase()] + '-' + m[1].padStart(2, '0');\n\n// === FIELD EXTRACTION ===\nfunction grabField(label, text) {\n  const patterns = [\n    new RegExp(label + '\\\\s*[:\\uff1a]\\\\s*([^\\n]+)', 'i'),\n    new RegExp(label + '\\\\s*([^\\n]+)', 'i')\n  ];\n  for (const p of patterns) {\n    const mm = text.match(p);\n    if (mm) return mm[1].trim().replace(/^[\\s\\-\\u2022]+|[\\s\\-\\u2022]+$/g, '').substring(0, 100);\n  }\n  return '';\n}\n\nconst lokasi = grabField('lokasi', pesan);\nconst vendor = grabField('(?:nama\\\\s+)?(?:vendor|perusahaan|pelaksana)', pesan);\nconst pengawas = grabField('pengawas(?:\\\\s+(?:area|site|lapangan))?', pesan);\n\n// === URAIAN SINGKAT (baris pertama, max 150 char) ===\nconst lines = pesan.split('\\n').filter(l => l.trim().length > 0);\nlet uraianSingkat = (lines[0] || '').replace(/[\\s]{2,}/g, ' ').trim().substring(0, 150);\nif (uraianSingkat.length < 10 && lines.length > 1) {\n  uraianSingkat = lines.slice(0, 2).join(' | ').replace(/[\\s]{2,}/g, ' ').trim().substring(0, 150);\n}\n\n// === VALIDASI KELENGKAPAN ===\nconst butuhVendor = ['JSA (Job Safety Analysis)', 'Safety Toolbox Meeting', 'Safety Induction'].includes(kategori);\nconst punyaPT = /\\b(pt|cv)\\.?\\s+\\S+/i.test(pesan);\nconst kurang = [];\nif (!m) kurang.push('Tanggal kegiatan (contoh: 08 Mei 2026)');\nif (butuhVendor && !vendor && !punyaPT) kurang.push('Nama perusahaan / vendor (PT / CV)');\nif (butuhVendor && !lokasi) kurang.push('Lokasi pekerjaan');\nconst lengkap = kurang.length === 0;\n\nlet balasan = '';\nif (lengkap) {\n  balasan = '\\u2705 *Laporan HSE Diterima*\\n\\nTerima kasih atas partisipasi Anda dalam menjaga keselamatan kerja.\\n\\ud83d\\ude4f *Safety First, Semua Pulang Selamat*';\n} else {\n  balasan = '\\u26a0\\ufe0f *Laporan HSE Kurang Lengkap*\\n\\nMohon periksa ulang dan kirim kembali laporan Anda. Bagian yang kurang:\\n- ' + kurang.join('\\n- ') + '\\n\\n\\ud83d\\ude4f *Safety First, Semua Pulang Selamat*';\n}\n\nreturn { json: {\n  valid: grub !== '',\n  lengkap: lengkap,\n  balasan: balasan,\n  balasTarget: j.grubId || '',\n  timestamp: $now.toFormat('yyyy-MM-dd HH:mm'),\n  tanggal: tanggal,\n  grub: grub,\n  area: area,\n  kategori: kategori,\n  uraian: uraianSingkat,\n  lokasi: lokasi,\n  vendor: vendor,\n  pengawas: pengawas,\n  pengirimNama: j.pengirimNama || '',\n  pengirimNo: j.pengirimNo || '',\n  pengirimLid: j.pengirimLid || '',\n  linkFile: j.linkFile || ''\n} };"
      },
